generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
  CREDIT_NOTE
}

enum UserRole {
  ADMIN
  READ_ONLY
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid()) @map("_id")
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole @default(READ_ONLY)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Company {
  id        String          @id @default(cuid()) @map("_id")
  name      String
  legalName String?
  gstin     String?
  state     String?
  stateCode String?
  address   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  invoices  Invoice[]
}

model Session {
  id        String   @id @default(cuid()) @map("_id")
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id           String      @id @default(cuid()) @map("_id")
  firstName    String
  lastName     String?
  company      String?
  name         String
  email        String?
  phone        String?
  mobile       String?
  website      String?
  address      String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?     @default("IN")
  vatGstNumber String?
  taxCodePan   String?
  stateCode    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  invoices     Invoice[]
  quotes       Quotation[]
  payments     Payment[]
}

model Product {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  sku           String?
  price         Float    @default(0)
  purchasePrice Float    @default(0)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id                 String        @id @default(cuid()) @map("_id")
  invoiceNumber      String        @unique
  invoiceNumberPrefix String?
  invoiceNumberSuffix String?
  clientId           String
  companyId          String?
  company            Company?      @relation(fields: [companyId], references: [id])
  creditNoteForId    String?
  creditNoteNumber   String?
  creditNoteReason   String?
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceGroupId     String?
  issueDate          DateTime      @default(now())
  dueDate            DateTime?
  status             InvoiceStatus @default(DRAFT)
  taxRate            Float         @default(0)
  discountPercent    Float         @default(0)
  discountAmount     Float         @default(0)
  subtotal           Float         @default(0)
  taxAmount          Float         @default(0)
  taxLines           Json?
  total              Float         @default(0)
  notes              String?
  terms              String?
  deliveryNote       String?
  referenceNo        String?
  otherReferences    String?
  buyerOrderNo       String?
  buyerOrderDate     DateTime?
  dispatchDocNo      String?
  deliveryNoteDate   DateTime?
  dispatchedThrough  String?
  destination        String?
  termsOfDelivery    String?
  consigneeName      String?
  consigneeAddress   String?
  consigneeGstin     String?
  consigneeState     String?
  consigneeStateCode String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  items              InvoiceItem[]
  payments           Payment[]

  @@index([clientId])
  @@index([companyId])
}

model InvoiceItem {
  id          String  @id @default(cuid()) @map("_id")
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  hsnSac      String?
  unit        String  @default("Nos")
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  taxRate     Float   @default(0)
  amount      Float   @default(0)

  @@index([invoiceId])
}

model Quotation {
  id             String      @id @default(cuid()) @map("_id")
  quoteNumber    String      @unique
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceGroupId String?
  issueDate      DateTime    @default(now())
  validUntil     DateTime?
  status         QuoteStatus @default(DRAFT)
  taxRate        Float       @default(0)
  subtotal       Float       @default(0)
  taxAmount      Float       @default(0)
  total          Float       @default(0)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          QuoteItem[]

  @@index([clientId])
}

model QuoteItem {
  id          String    @id @default(cuid()) @map("_id")
  quoteId     String
  quote       Quotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Float     @default(1)
  unitPrice   Float     @default(0)
  taxRate     Float     @default(0)
  amount      Float     @default(0)

  @@index([quoteId])
}

model Payment {
  id        String   @id @default(cuid()) @map("_id")
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  method    String
  amount    Float
  paidAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([clientId])
}

model TaxRate {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  rate      Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PaymentMethod {
  id        String   @id @default(cuid()) @map("_id")
  name      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model InvoiceGroup {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  template  String
  nextId    Int      @default(1)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid()) @map("_id")
  key   String @unique
  value String
}
