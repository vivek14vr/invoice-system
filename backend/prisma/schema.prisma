generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
  CREDIT_NOTE
}

enum UserRole {
  ADMIN
  READ_ONLY
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid()) @map("_id")
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole @default(READ_ONLY)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  workspaceMemberships WorkspaceMembership[]
}

model Company {
  id        String          @id @default(cuid()) @map("_id")
  name      String
  legalName String?
  gstin     String?
  state     String?
  stateCode String?
  address   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  memberships WorkspaceMembership[]
  activeSessions Session[] @relation("ActiveWorkspace")
  clients   Client[]
  products  Product[]
  quotations Quotation[]
  payments  Payment[]
  taxRates TaxRate[]
  paymentMethods PaymentMethod[]
  invoiceGroups InvoiceGroup[]
  settings Setting[]
  invoices  Invoice[]
  expenses  Expense[]
}

model Session {
  id        String   @id @default(cuid()) @map("_id")
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompanyId String?
  activeCompany Company? @relation("ActiveWorkspace", fields: [activeCompanyId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([activeCompanyId])
}

model WorkspaceMembership {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  companyId String
  role      UserRole @default(READ_ONLY)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

model Client {
  id           String      @id @default(cuid()) @map("_id")
  firstName    String
  lastName     String?
  company      String?
  name         String
  email        String?
  phone        String?
  mobile       String?
  website      String?
  address      String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?     @default("IN")
  vatGstNumber String?
  taxCodePan   String?
  stateCode    String?
  companyId    String?
  workspace    Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  invoices     Invoice[]
  quotes       Quotation[]
  payments     Payment[]

  @@index([companyId])
}

model Product {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  sku           String?
  price         Float    @default(0)
  purchasePrice Float    @default(0)
  description   String?
  companyId     String?
  workspace     Company? @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

model Invoice {
  id                 String        @id @default(cuid()) @map("_id")
  invoiceNumber      String
  invoiceNumberPrefix String?
  invoiceNumberSuffix String?
  clientId           String
  companyId          String?
  company            Company?      @relation(fields: [companyId], references: [id])
  creditNoteForId    String?
  creditNoteNumber   String?
  creditNoteReason   String?
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceGroupId     String?
  issueDate          DateTime      @default(now())
  dueDate            DateTime?
  status             InvoiceStatus @default(DRAFT)
  taxRate            Float         @default(0)
  discountPercent    Float         @default(0)
  discountAmount     Float         @default(0)
  subtotal           Float         @default(0)
  taxAmount          Float         @default(0)
  taxLines           Json?
  total              Float         @default(0)
  notes              String?
  terms              String?
  deliveryNote       String?
  referenceNo        String?
  otherReferences    String?
  buyerOrderNo       String?
  buyerOrderDate     DateTime?
  dispatchDocNo      String?
  deliveryNoteDate   DateTime?
  dispatchedThrough  String?
  destination        String?
  termsOfDelivery    String?
  consigneeName      String?
  consigneeAddress   String?
  consigneeGstin     String?
  consigneeState     String?
  consigneeStateCode String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  items              InvoiceItem[]
  payments           Payment[]

  @@index([clientId])
  @@index([companyId])
  @@unique([companyId, invoiceNumber])
}

model InvoiceItem {
  id          String  @id @default(cuid()) @map("_id")
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  hsnSac      String?
  unit        String  @default("Nos")
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  taxRate     Float   @default(0)
  amount      Float   @default(0)

  @@index([invoiceId])
}

model Quotation {
  id             String      @id @default(cuid()) @map("_id")
  quoteNumber    String
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceGroupId String?
  companyId      String?
  workspace      Company?    @relation(fields: [companyId], references: [id])
  issueDate      DateTime    @default(now())
  validUntil     DateTime?
  status         QuoteStatus @default(DRAFT)
  taxRate        Float       @default(0)
  subtotal       Float       @default(0)
  taxAmount      Float       @default(0)
  total          Float       @default(0)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          QuoteItem[]

  @@index([clientId])
  @@index([companyId])
  @@unique([companyId, quoteNumber])
}

model QuoteItem {
  id          String    @id @default(cuid()) @map("_id")
  quoteId     String
  quote       Quotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Float     @default(1)
  unitPrice   Float     @default(0)
  taxRate     Float     @default(0)
  amount      Float     @default(0)

  @@index([quoteId])
}

model Payment {
  id        String   @id @default(cuid()) @map("_id")
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  method    String
  amount    Float
  paidAt    DateTime @default(now())
  notes     String?
  companyId String?
  workspace Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([clientId])
  @@index([companyId])
}

model Expense {
  id            String    @id @default(cuid()) @map("_id")
  invoiceNumber String
  vendorName    String?
  vatGstNumber  String?
  category      String
  paymentMode   String
  expenseDate   DateTime  @default(now())
  itemDetails   String
  quantity      Float     @default(1)
  amount        Float
  gstRate       Float     @default(0)
  gstAmount     Float     @default(0)
  total         Float
  balanceDue    Float     @default(0)
  notes         String?
  attachmentId  String?
  attachmentName String?
  attachmentMimeType String?
  attachmentSize Int?
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@index([expenseDate])
}

model TaxRate {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  rate      Float
  isDefault Boolean  @default(false)
  companyId String?
  workspace Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId])
}

model PaymentMethod {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  isDefault Boolean  @default(false)
  companyId String?
  workspace Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

model InvoiceGroup {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  template  String
  nextId    Int      @default(1)
  isDefault Boolean  @default(false)
  companyId String?
  workspace Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Setting {
  id    String @id @default(cuid()) @map("_id")
  key   String
  value String
  companyId String?
  workspace Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@index([companyId])
}
